# Settings
set ignorecase true
set icons true
set rulerfile "~/.local/config/lf/ruler"

# Creating a file/directory
cmd create ${{
  printf "file Name: "
  read ans
  if [ "$(echo $ans | tail -c 2)" = "/" ]; then
    mkdir $(echo $ans | sed 's/\///g')
  else
    touch "$ans"
  fi
}}

# Trashing a file
cmd trash ${{
  for file in $fx; do
    gtrash put "$file"
  done
}}

# Permanently removing a file
cmd remove ${{
  rm -rf "$fx"
}}

cmd open ${{
  xdg-open $fx
}}

# Opening a file with neovim
cmd nvim ${{
  nvim "$f"
}}

cmd peek_shell ${{
  printf "\npress ENTER to continue\n"
  read _
}}

# Unbinding
map d
map m
map v
map u
map <space>

# Basic
map a create
map dd trash
map DD remove

# Copying and pasting
map y copy
map Y cut
map p paste

# Selection
map v :toggle; down
map V :toggle; up

# Misc
map . set hidden!
map <esc> :clear;unselect;reload
map <space>v nvim
map \# peek_shell

# Gotos
map gp cd ~/projects
map gs cd ~/screenshots
map gl cd ~/.local
map gb cd ~/.local/bin
map gc cd ~/.local/config
map gt cd ~/.local/share/trash
map g/ cd /

