#!/usr/bin/sh

killall waybar
killall hyprpaper
killall dunst
killall wl-clip-persist

hyprctl dispatch exec waybar
hyprctl dispatch exec hyprpaper
hyprctl dispatch exec dunst
hyprctl dispatch exec pipewire
hyprctl dispatch exec pipewire-pulse
#hyprctl dispatch exec "wl-clip-persist --clipboard both"

eww reload

if [ $(ps -x | grep wireplumber | wc -l) -ne 2 ]
then	
	killall wireplumber 
	hyprctl dispatch exec wireplumber
fi
