# Settings
set previewer ~/.config/lf/previewer
set ignorecase true
set icons true
set sixel true
set rulerfmt "%d  |%a  |%p  |\033[7;31m %m \033[0m  |\033[7;33m %c \033[0m  |\033[7;35m %s \033[0m  |\033[7;34m %f \033[0m  |%i/%t"

# Creating a directory
cmd mkdir ${{
  printf "directory Name: "
  read ans
  mkdir $ans
}}

# Creating a file
cmd mkfile ${{
  printf "file Name: "
  read ans
  $EDITOR $ans
}}

# Compression & archives
cmd unarchive ${{
  case "$f" in
      *.zip) unzip "$f" ;;
      *.rar) unrar x "$f" ;;
      *.tar.gz) tar -xzvf "$f" ;;
      *.tar.bz2) tar -xjvf "$f" ;;
      *.tar) tar -xvf "$f" ;;
      *.7z) 7z e "$f" ;;
      *) echo "Unsupported format" ;;
  esac
}}

# Trashing a file
cmd trash ${{
  for file in $fx; do
    mv $file ~/.local/share/trash
  done
}}

# Permanently removing a file
cmd remove ${{
  for file in $fx; do
    rm $file
  done
}}

cmd nvim ${{
  nvim "$f"
}}

# Unbinding
map d
map m
map <enter>

# Keybinds
map . set hidden!
map o mkfile
map O mkdir
map d trash
map D remove
map y copy
map p paste
map x cut

map <enter> nvim
map <escape> clear
map R reload

map au unarchive

map gp cd ~/projects
map gs cd ~/screenshots
map gl cd ~/.local
map gb cd ~/.local/bin
map gc cd ~/.local/config
map gt cd ~/.local/share/trash

