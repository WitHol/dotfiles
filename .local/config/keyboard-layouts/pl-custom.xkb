xkb_keymap {
    xkb_types { include "complete" };
    xkb_compat { include "complete" };
    xkb_geometry { include "pc(pc105)" };
    xkb_keycodes { include "evdev" };
    xkb_symbols {
        include "pc+us+inet(evdev)"

        key <RALT> {[ ISO_Level3_Shift ], type[group1]="ONE_LEVEL" };
        key <CAPS> {[ ISO_Level3_Shift ], type[group1]="ONE_LEVEL" };

        key <TLDE> {[    Multi_key, asciitilde                                   ]};
        key <AE01> {[            1, exclam,     combining_acute, combining_grave ]}; 
        key <AE02> {[            2, at,                   U030C, U0302           ]}; 
        key <AE03> {[            3, hash,                 U0308, combining_tilde ]}; 
        key <AE04> {[            4, dollar,               U0304, U0306           ]}; 
        key <AE05> {[            5, percent                                      ]};
        key <AE06> {[            6, caren                                        ]};
        key <AE07> {[            7, ampersand                                    ]};
        key <AE08> {[            8, asterisk                                     ]};
        key <AE09> {[            9, parenleft                                    ]};
        key <AE10> {[            0, parenright                                   ]};

        key <AD01> {[            q, Q                                            ]};
        key <AD02> {[            w, W                                            ]};
        key <AD03> {[            e, E,                  eogonek, Eogonek         ]}; 
        key <AD04> {[            r, R                                            ]};
        key <AD05> {[            t, T                                            ]};
        key <AD06> {[            y, Y                                            ]};
        key <AD07> {[            u, U                                            ]};
        key <AD08> {[            i, I                                            ]};
        key <AD09> {[            o, O,                   oacute, Oacute          ]}; 
        key <AD10> {[            p, P                                            ]};
        key <AD11> {[  bracketleft, braceleft                                    ]};
        key <AD12> {[ bracketright, braceright                                   ]};

        key <AC01> {[            a, A,                  aogonek, Aogonek         ]}; 
        key <AC02> {[            s, S,                   sacute, Sacute          ]}; 
        key <AC03> {[            d, D                                            ]};
        key <AC04> {[            f, F                                            ]};
        key <AC05> {[            g, G                                            ]};
        key <AC06> {[            h, H                                            ]};
        key <AC07> {[            j, J                                            ]};
        key <AC08> {[            k, K                                            ]};
        key <AC09> {[            l, L,                  lstroke, Lstroke         ]}; 
        key <AC10> {[    semicolon, colon,           dead_greek                  ]};
        key <AC11> {[   apostrophe, quotedbl,     dead_currency                  ]};
         
        key <AB01> {[            z, Z,                     zdot, Zdot            ]}; 
        key <AB02> {[            x, X,                  zstroke, Zstroke         ]}; 
        key <AB03> {[            c, C,                  cstroke, Cstroke         ]}; 
        key <AB04> {[            v, V                                            ]};
        key <AB05> {[            b, B                                            ]};
        key <AB06> {[            n, N,                  nstroke, Nstroke         ]}; 
        key <AB07> {[            m, M                                            ]};
    };
};

